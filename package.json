{
  "name": "dayamora-store",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "dev": "node server.cjs",
    "start": "node server.cjs",
    "dev:local": "node server-sqlite.cjs",
    "db:init": "node scripts/db-init.cjs",
    "test": "node --test tests/unit.test.cjs tests/cloud.test.cjs tests/campaign.test.cjs tests/options.test.cjs tests/outfit.test.cjs tests/garment-mask.test.cjs tests/discovery.test.cjs tests/coupons.test.cjs tests/cutout-registry.test.cjs tests/payment-metadata.test.cjs",
    "test:local": "node --test tests/integration.test.cjs",
    "build": "node scripts/check-build.cjs",
    "test:cloud": "node --test tests/features-cloud.test.cjs tests/outfit-cloud.test.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1154.0",
    "@neondatabase/serverless": "1.2.0",
    "@smithy/node-http-handler": "4.12.1",
    "dotenv": "17.2.3",
    "https-proxy-agent": "7.0.6",
    "ws": "8.22.0"
  }
}
